# Branding
BRAND_NAME=OnlineMP4
SITE_URL=http://localhost:3000
CONTACT_EMAIL=support@example.com

# --- Bandwidth ---------------------------------------------------------------
# Absolute URL of the Cloudflare Worker in worker/cdn-proxy.js. When set,
# progressive (single-file) downloads stream from the source CDN through the
# edge instead of this server — host bandwidth per download drops to ~2 KB.
# Leave empty to fall back to /api/download/stream (still no disk writes, but
# the bytes do pass through this host).
CDN_PROXY_URL=

# HMAC key for signing direct download links. Must match the Worker's secret.
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=

# How long a minted direct link stays valid, in seconds.
DIRECT_LINK_TTL=900

# --- Resource limits ---------------------------------------------------------
# Cap for server-side (merge/convert) downloads.
MAX_FILE_SIZE_MB=500
# Total yt-dlp jobs running at once across the whole instance.
MAX_CONCURRENT_JOBS=3
# Jobs one IP may have running at once.
MAX_CONCURRENT_JOBS_PER_IP=1
# Hard kill for a single yt-dlp process.
DOWNLOAD_TIMEOUT_SECONDS=600

# --- Abuse protection --------------------------------------------------------
# API requests allowed per IP per minute.
MAX_REQUESTS_PER_IP=20

# --- Temporary storage -------------------------------------------------------
# How long a finished file waits to be collected before it is deleted.
TEMP_FILE_TTL=600
# How often the orphaned-file sweeper runs, in seconds.
CLEANUP_INTERVAL=1800
# Where temporary downloads are written (relative to project root, or absolute).
TEMP_DOWNLOAD_DIR=tmp-downloads

# --- Adsterra ----------------------------------------------------------------
# One publisher key per placement — the `key` value from Adsterra's Banner
# invocation snippet (32 hex chars). Empty = that slot stays a blank reserved
# box and loads no third-party script. Sizes are set in src/components/AdSlot.tsx
# and must match the ad unit you created in Adsterra.
#
# These are public by design (they appear in page source), which is why they use
# the NEXT_PUBLIC_ prefix. They are not secrets.
NEXT_PUBLIC_ADSTERRA_TOP=
NEXT_PUBLIC_ADSTERRA_AFTER_DOWNLOADER=
NEXT_PUBLIC_ADSTERRA_MIDDLE=
NEXT_PUBLIC_ADSTERRA_BOTTOM=
NEXT_PUBLIC_ADSTERRA_SIDEBAR=

# yt-dlp binary path (must be on PATH, or set an absolute path)
YTDLP_PATH=yt-dlp

# --- YouTube authentication --------------------------------------------------
# YouTube bot-checks datacenter IPs ("Sign in to confirm you're not a bot"), so
# hosted deployments need cookies from a signed-in session. The same yt-dlp
# version works fine from a home connection — this is IP reputation, not a bug.
#
# Locally, point at a Netscape-format cookies.txt:
YTDLP_COOKIES_FILE=
#
# In production, paste the same file base64-encoded — Railway and similar hosts
# have no persistent disk, so a path alone can never be satisfied there:
#   base64 -w0 cookies.txt          # Linux/macOS/Git Bash
YTDLP_COOKIES_B64=
#
# WARNING: a cookie jar is a live credential. Anyone holding it is signed in as
# that account, and 2FA does not stop them. Use a THROWAWAY Google account with
# no payment method attached — never a personal one. Never commit cookies.txt.
# Rotate by signing that account out of all sessions.
#
# Expect to re-export every few weeks; YouTube expires these, faster when it
# sees them used from a datacenter. When they lapse, /api/extract returns
# code "auth_required" and the logs carry "[yt-dlp] cookies rejected".

# Optional mobile units (create these as 320x50 banners in Adsterra). Without
# them the desktop unit is used at every width, so a 728x90 gets clipped on a
# phone.
NEXT_PUBLIC_ADSTERRA_TOP_MOBILE=
NEXT_PUBLIC_ADSTERRA_AFTER_DOWNLOADER_MOBILE=
NEXT_PUBLIC_ADSTERRA_MIDDLE_MOBILE=
NEXT_PUBLIC_ADSTERRA_BOTTOM_MOBILE=
NEXT_PUBLIC_ADSTERRA_SIDEBAR_MOBILE=
